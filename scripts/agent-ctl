#!/usr/bin/env python3
"""
agent-ctl — Homelab Worker Agent Central CLI Controller
Allows Antigravity AI (Asrida) and terminal scripts to inspect and control
any connected Windows / Linux / macOS worker node (e.g. asridaytrade, servergigi).

Usage:
  agent-ctl status
  agent-ctl nodes
  agent-ctl exec <nodeId> "<command>" [--shell powershell|cmd|bash] [--cwd <dir>] [--timeout <sec>]
  agent-ctl sysinfo <nodeId>
  agent-ctl ls <nodeId> [path]
  agent-ctl read <nodeId> <remotePath>
  agent-ctl write <nodeId> <remotePath> <localFileOrContent> [--from-file <localPath>]
  agent-ctl edit <nodeId> <remotePath> --target "<old>" --replace "<new>"
  agent-ctl render <nodeId|auto> [--input <localPath>] [--test] [--nvenc]
  agent-ctl remotion --props <file.json> -o <out.mp4> [--comp StudioEngine] [--node <id|auto>] [--concurrency <n>] [--timeout <sec>]
  agent-ctl blender --script <file.py> [--node <id|auto>] [--live-session <bv>] [--wait]
  agent-ctl rename <node> "<alias>" [--notes "<notes>"] [--clear]
  agent-ctl update <nodeId>

Blender Live Helpers (available inside bpy scripts):
  live_snapshot(label="")      Save current viewport/render frame to BLENDER_LIVE_FILE
  live_progress(pct, msg="")   Emit LAB_PROGRESS <pct> <msg> for live progress bar
"""

import argparse
import json
import os
import subprocess
import sys
import tarfile
import time
import urllib.error
import urllib.parse
import urllib.request

HUB_BASE = os.environ.get("HOMELAB_HUB_API", "http://172.17.0.1:8090")
CONFIG_PATH = "/home/dev/.gemini/agent-hub/config.json"
DEFAULT_TOKEN = "hlag_7f8e9a2b4c6d1e3f5a7b9c0d2e4f6a8b"


def get_token() -> str:
    try:
        if os.path.exists(CONFIG_PATH):
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                d = json.load(f)
                if d.get("token"):
                    return d["token"]
    except Exception:
        pass
    return os.environ.get("HOMELAB_AGENT_TOKEN", DEFAULT_TOKEN)


def hub_request(method: str, path: str, body: dict | None = None, timeout: int = 65) -> dict:
    url = HUB_BASE.rstrip("/") + path
    headers = {
        "X-Agent-Token": get_token(),
        "Accept": "application/json",
    }
    data = None
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            return json.loads(raw) if raw.strip() else {"ok": True}
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8", errors="replace")
        try:
            parsed = json.loads(err_body)
            if isinstance(parsed, dict):
                parsed.setdefault("_http_status", e.code)
                return parsed
            return {"ok": False, "_http_status": e.code, "error": f"HTTP {e.code}: {err_body}"}
        except Exception:
            return {"ok": False, "_http_status": e.code, "error": f"HTTP {e.code}: {err_body}"}
    except Exception as e:
        return {"ok": False, "error": str(e)}


def hub_download(path: str, dest_path: str, timeout: int = 120) -> bool:
    url = HUB_BASE.rstrip("/") + path
    req = urllib.request.Request(url, headers={"X-Agent-Token": get_token()}, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            if resp.status != 200:
                return False
            os.makedirs(os.path.dirname(dest_path), exist_ok=True)
            with open(dest_path, "wb") as f:
                while True:
                    chunk = resp.read(65536)
                    if not chunk:
                        break
                    f.write(chunk)
        return True
    except Exception:
        return False


def resolve_node_target(raw_ref: str) -> str:
    q = (raw_ref or "").strip()
    if not q or q.lower() == "auto":
        return q
    st = hub_request("GET", "/api/agent-hub/status", timeout=15)
    if not st.get("ok"):
        return q
    nodes_list = st.get("nodes") or []
    ql = q.lower()

    for n in nodes_list:
        if str(n.get("nodeId", "")).lower() == ql:
            return n["nodeId"]

    exact_alias = [n for n in nodes_list if str(n.get("alias", "")).strip().lower() == ql]
    if len(exact_alias) == 1:
        return exact_alias[0]["nodeId"]

    exact_host = [n for n in nodes_list if str((n.get("specs") or {}).get("hostname", "")).strip().lower() == ql]
    if len(exact_host) == 1:
        return exact_host[0]["nodeId"]

    partial = [
        n
        for n in nodes_list
        if any(
            ql in str(val).lower()
            for val in (
                n.get("nodeId", ""),
                n.get("alias", ""),
                (n.get("specs") or {}).get("hostname", ""),
                n.get("notes", ""),
            )
            if val
        )
    ]
    if len(partial) == 1:
        return partial[0]["nodeId"]
    if len(partial) > 1:
        names = ", ".join(f"{n.get('alias') or n.get('nodeId')} ({n.get('nodeId')})" for n in partial)
        raise SystemExit(f"Error: ชื่อเครื่อง '{q}' ตรงกับหลายเครื่อง: {names}")
    return q


def run_node_cmd(node_id: str, action: str, payload: dict, timeout_sec: int = 45) -> dict:
    resolved_id = resolve_node_target(node_id)
    return hub_request(
        "POST",
        "/api/agent-hub/command",
        {
            "nodeId": resolved_id,
            "action": action,
            "payload": payload,
            "wait": True,
            "timeoutMs": timeout_sec * 1000,
        },
        timeout=timeout_sec + 10,
    )


def fmt_bytes(b: int | float) -> str:
    if not b or b <= 0:
        return "0 B"
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if b < 1024:
            return f"{b:.1f} {unit}"
        b /= 1024
    return f"{b:.1f} PB"


def main() -> int:
    parser = argparse.ArgumentParser(description="Homelab Worker Agent Controller")
    sub = parser.add_subparsers(dest="cmd")

    p_status = sub.add_parser("status", help="Show full Agent Hub status JSON")
    p_status.add_argument("--json", action="store_true")

    p_nodes = sub.add_parser("nodes", help="List registered worker nodes")
    p_nodes.add_argument("--json", action="store_true")

    p_exec = sub.add_parser("exec", help="Execute a shell command on a remote node")
    p_exec.add_argument("node", help="Target node ID (e.g. asridaytrade)")
    p_exec.add_argument("command", help="Command string to execute")
    p_exec.add_argument("--shell", default="auto", choices=["auto", "powershell", "cmd", "bash", "sh"])
    p_exec.add_argument("--cwd", default="")
    p_exec.add_argument("--timeout", type=int, default=120)
    p_exec.add_argument("--json", action="store_true")

    p_sys = sub.add_parser("sysinfo", help="Fetch live specs, metrics, and top processes from a node")
    p_sys.add_argument("node")

    p_ls = sub.add_parser("ls", help="List directory contents on a remote node")
    p_ls.add_argument("node")
    p_ls.add_argument("path", nargs="?", default="")
    p_ls.add_argument("--json", action="store_true")

    p_read = sub.add_parser("read", help="Read a file from a remote node")
    p_read.add_argument("node")
    p_read.add_argument("path")
    p_read.add_argument("--json", action="store_true")

    p_write = sub.add_parser("write", help="Write content to a file on a remote node")
    p_write.add_argument("node")
    p_write.add_argument("path")
    p_write.add_argument("content", nargs="?", default="")
    p_write.add_argument("--from-file", dest="from_file", default="")
    p_write.add_argument("--append", action="store_true")

    p_edit = sub.add_parser("edit", help="Replace target string in a remote file")
    p_edit.add_argument("node")
    p_edit.add_argument("path")
    p_edit.add_argument("--target", required=True)
    p_edit.add_argument("--replace", required=True)

    p_render = sub.add_parser("render", help="Dispatch a distributed FFmpeg render job")
    p_render.add_argument("node", nargs="?", default="auto")
    p_render.add_argument("--input", default="")
    p_render.add_argument("--test", action="store_true", help="Run a 5s 1080x1920 test render")
    p_render.add_argument("--duration", type=int, default=5)
    p_render.add_argument("--crf", type=int, default=20)

    p_remotion = sub.add_parser("remotion", help="Dispatch a distributed Remotion render job")
    p_remotion.add_argument("--props", required=True, help="Path to local props.json")
    p_remotion.add_argument("--comp", default="StudioEngine", help="Remotion composition ID (default: StudioEngine)")
    p_remotion.add_argument("-o", "--output", required=True, help="Local output .mp4 path")
    p_remotion.add_argument("--node", default="auto", help="Target node ID or 'auto' (default: auto)")
    p_remotion.add_argument("--concurrency", type=int, default=None, help="Render concurrency")
    p_remotion.add_argument("--timeout", type=int, default=3600, help="Wait timeout in seconds (default: 3600)")

    p_blender = sub.add_parser(
        "blender",
        help="Dispatch a Blender 3D job with live streaming (bpy scripts can call live_snapshot(label) & live_progress(pct, msg))",
    )
    p_blender.add_argument("--script", required=True, help="Path to local .py Blender script")
    p_blender.add_argument("--node", default="auto", help="Target node ID or 'auto' (default: auto)")
    p_blender.add_argument("--output", default="", help="Output .glb filename")
    p_blender.add_argument("--preview", default="", help="Preview .png filename")
    p_blender.add_argument("--gpu", action="store_true", help="Prefer GPU node")
    p_blender.add_argument("--live-session", dest="live_session", default="", help="Browser Vision session name (e.g. bv_xxx)")
    p_blender.add_argument("--wait", action="store_true", help="Wait for completion, stream progress, and download outputs")
    p_blender.add_argument("--timeout", type=int, default=1800, help="Wait timeout in seconds (default: 1800)")
    p_blender.add_argument("--out-dir", dest="out_dir", default="/home/dev/.gemini/outputs/3d", help="Local output directory")

    p_rename = sub.add_parser("rename", help="Set display alias and project notes for a node")
    p_rename.add_argument("node", help="Target node ID or current alias")
    p_rename.add_argument("alias", nargs="?", default="", help="Human-friendly display alias")
    p_rename.add_argument("--notes", default=None, help="Project paths or notes")
    p_rename.add_argument("--clear", action="store_true", help="Clear alias")

    p_upd = sub.add_parser("update", help="Trigger self-update on a remote node")
    p_upd.add_argument("node")

    p_run = sub.add_parser("run", help="Dispatch a generic offload job (job.run) to a worker node")
    p_run.add_argument("--name", default=None, help="Job name label (e.g. whisper-transcribe)")
    p_run.add_argument("--requires", default=None, help="Comma-separated required capabilities (e.g. python,nvidia-gpu)")
    p_run.add_argument("--os", default=None, choices=["any", "windows", "linux", "darwin"], help="Target OS (default: any)")
    p_run.add_argument("--node", default=None, help="Target node ID, alias, or 'auto' (default: auto)")
    p_run.add_argument("--input", action="append", default=None, help="Input file/dir path on homelab (repeatable)")
    p_run.add_argument("--cmd", dest="cmd_str", default=None, help="Shell command string to execute")
    p_run.add_argument("--cmd-win", dest="cmd_win", default=None, help="Windows-specific command string")
    p_run.add_argument("--cmd-posix", dest="cmd_posix", default=None, help="POSIX (Linux/macOS) command string")
    p_run.add_argument("--setup", default=None, help="Setup command (e.g. pip install ...)")
    p_run.add_argument("--cache-key", dest="cache_key", default=None, help="Setup cache key ([a-zA-Z0-9._-]{1,64})")
    p_run.add_argument("--collect", action="append", default=None, help="Relative path/glob to collect into result.tar.gz (repeatable)")
    p_run.add_argument("--env", action="append", default=None, help="Environment variable KEY=VAL (repeatable)")
    p_run.add_argument("--timeout", type=int, default=None, help="Job timeout in seconds")
    p_run.add_argument("--out-dir", dest="out_dir", default=None, help="Local output dir (default: /home/dev/.gemini/outputs/offload/<jobId>)")
    p_run.add_argument("--spec", default=None, help="Load job spec from JSON file (CLI flags override)")
    p_run.add_argument("--json", action="store_true", help="Print final result as single-line JSON")
    p_run.add_argument("--no-wait", dest="no_wait", action="store_true", help="Submit job and exit immediately with jobId")

    p_cancel = sub.add_parser("cancel", help="Cancel a running job on Agent Hub")
    p_cancel.add_argument("job_id", metavar="jobId", help="Job ID to cancel")
    p_cancel.add_argument("--json", action="store_true", help="Print response as JSON")

    p_jobs = sub.add_parser("jobs", help="List recent jobs on Agent Hub")
    p_jobs.add_argument("--kind", default=None, help="Filter by job kind (e.g. generic, remotion, blender)")
    p_jobs.add_argument("--limit", type=int, default=20, help="Maximum number of jobs to show (default: 20)")
    p_jobs.add_argument("--json", action="store_true", help="Print response as JSON")

    args = parser.parse_args()
    if not args.cmd or args.cmd == "nodes":
        st = hub_request("GET", "/api/agent-hub/status")
        if getattr(args, "json", False):
            print(json.dumps(st, ensure_ascii=False, indent=2))
            return 0
        if not st.get("ok"):
            print(f"Error: {st.get('error')}", file=sys.stderr)
            return 1
        nodes = st.get("nodes", [])
        print(f"=== Homelab Agent Hub (Online: {st.get('cluster', {}).get('onlineNodes', 0)}/{len(nodes)}) ===")
        if not nodes:
            print("  (ยังไม่มีเครื่องลูกเชื่อมต่อเข้ามา)")
        for n in nodes:
            sp = n.get("specs", {})
            mt = n.get("metrics", {})
            badge = "🟢 ONLINE" if n.get("online") else "⚪ OFFLINE"
            gpu = sp.get("gpuModel") or "No discrete GPU"
            nv = " [NVENC]" if sp.get("hasNvenc") else ""
            alias_str = f" [🏷️ {n['alias']}]" if n.get("alias") else ""
            print(
                f"  • {n.get('nodeId')}{alias_str} ({sp.get('hostname', '-')}) — {badge} | "
                f"{sp.get('osCaption', sp.get('os', '-'))} | "
                f"CPU: {sp.get('cpuModel', '-')} ({sp.get('cpuThreads', 0)}T, {mt.get('cpuPct', 0):.1f}%) | "
                f"RAM: {fmt_bytes(mt.get('memUsed', 0))}/{fmt_bytes(mt.get('memTotal', 0))} ({mt.get('memPct', 0):.1f}%) | "
                f"GPU: {gpu}{nv} | IP: {', '.join(sp.get('ips', [])) or n.get('lastIp', '-')}"
            )
            if n.get("notes"):
                print(f"      📌 {n['notes']}")
        return 0

    if args.cmd == "status":
        st = hub_request("GET", "/api/agent-hub/status")
        print(json.dumps(st, ensure_ascii=False, indent=2))
        return 0

    if args.cmd == "exec":
        res = run_node_cmd(
            args.node,
            "exec",
            {"command": args.command, "shell": args.shell, "cwd": args.cwd, "timeoutSec": args.timeout},
            timeout_sec=args.timeout + 5,
        )
        if args.json:
            print(json.dumps(res, ensure_ascii=False, indent=2))
            return 0 if res.get("ok") else 1
        if not res.get("ok"):
            print(f"Error: {res.get('error')}", file=sys.stderr)
            return 1
        data = res.get("data") or {}
        if data.get("stdout"):
            sys.stdout.write(data["stdout"])
            if not data["stdout"].endswith("\n"):
                sys.stdout.write("\n")
        if data.get("stderr"):
            sys.stderr.write(data["stderr"])
            if not data["stderr"].endswith("\n"):
                sys.stderr.write("\n")
        return int(data.get("exitCode") or 0)

    if args.cmd == "sysinfo":
        res = run_node_cmd(args.node, "sysinfo", {}, timeout_sec=30)
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0 if res.get("ok") else 1

    if args.cmd == "ls":
        res = run_node_cmd(args.node, "fs.list", {"path": args.path}, timeout_sec=30)
        if args.json or not res.get("ok"):
            print(json.dumps(res, ensure_ascii=False, indent=2))
            return 0 if res.get("ok") else 1
        data = res.get("data") or {}
        print(f"Directory: {data.get('path')}")
        for item in data.get("items", []):
            kind = "📁 DIR " if item.get("isDir") else "📄 FILE"
            sz = "" if item.get("isDir") else f" ({fmt_bytes(item.get('size', 0))})"
            print(f"  {kind}  {item.get('name')}{sz}  ->  {item.get('path')}")
        return 0

    if args.cmd == "read":
        res = run_node_cmd(args.node, "fs.read", {"path": args.path}, timeout_sec=30)
        if args.json or not res.get("ok"):
            print(json.dumps(res, ensure_ascii=False, indent=2))
            return 0 if res.get("ok") else 1
        sys.stdout.write((res.get("data") or {}).get("content", ""))
        return 0

    if args.cmd == "write":
        content = args.content
        if args.from_file:
            with open(args.from_file, "r", encoding="utf-8") as f:
                content = f.read()
        res = run_node_cmd(
            args.node,
            "fs.write",
            {"path": args.path, "content": content, "append": args.append},
            timeout_sec=45,
        )
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0 if res.get("ok") else 1

    if args.cmd == "edit":
        res = run_node_cmd(
            args.node,
            "fs.edit",
            {"path": args.path, "target": args.target, "replacement": args.replace},
            timeout_sec=30,
        )
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0 if res.get("ok") else 1

    if args.cmd == "render":
        res = hub_request(
            "POST",
            "/api/agent-hub/render-jobs",
            {
                "nodeId": args.node,
                "inputPath": args.input,
                "testMode": args.test or not bool(args.input),
                "durationSec": args.duration,
                "crf": args.crf,
            },
        )
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0 if res.get("ok") else 1

    if args.cmd == "remotion":
        payload = {
            "nodeId": args.node,
            "propsPath": os.path.abspath(args.props),
            "compositionId": args.comp,
            "outputName": os.path.basename(args.output),
        }
        if args.concurrency is not None:
            payload["concurrency"] = args.concurrency
        res = hub_request("POST", "/api/agent-hub/remotion-jobs", payload, timeout=30)
        if not res.get("ok") or not (res.get("job") or {}).get("jobId"):
            reason = res.get("error") or res.get("code") or "hub unavailable"
            print(f"[render-node] none: {reason}", file=sys.stderr, flush=True)
            return 3

        job = res["job"]
        job_id = job["jobId"]
        node_id = job.get("nodeId") or args.node
        print(f"[render-node] {node_id}", flush=True)

        def warn_no_cancel():
            print(
                f"Warning: remote job {job_id} could not be cancelled (no hub cancel endpoint)",
                file=sys.stderr,
                flush=True,
            )

        start_t = time.time()
        last_update_t = start_t
        last_activity = None
        last_status = ""
        while True:
            now = time.time()
            if now - start_t > args.timeout:
                print(f"Error: remote render timed out after {args.timeout}s", file=sys.stderr, flush=True)
                warn_no_cancel()
                return 4

            jres = hub_request("GET", f"/api/agent-hub/jobs/{job_id}", timeout=15)
            if jres.get("ok") and jres.get("job"):
                j = jres["job"]
                status = j.get("status", "")
                progress = j.get("progress", 0) or 0
                message = j.get("message", "") or ""
                updated_at = j.get("updatedAt")
                last_status = status

                activity = (progress, status, message, updated_at)
                if activity != last_activity:
                    last_activity = activity
                    last_update_t = now
                    print(f"Rendered {round(progress)}/100 ({status}) {message}", flush=True)

                if status == "completed":
                    ok = hub_download(f"/api/agent-hub/jobs/{job_id}/output", args.output, timeout=600)
                    if ok and os.path.isfile(args.output) and os.path.getsize(args.output) > 10240:
                        return 0
                    print("Error: downloaded output file missing or <= 10KB", file=sys.stderr, flush=True)
                    warn_no_cancel()
                    return 4

                if status == "failed":
                    err = j.get("error") or message or "remote render failed"
                    print(f"Error: {err}", file=sys.stderr, flush=True)
                    warn_no_cancel()
                    return 4

            stall_threshold = 1500 if last_status in ("downloading", "installing") else 300
            if now - last_update_t > stall_threshold:
                print(
                    f"Error: remote render stalled (no activity for >{stall_threshold}s)",
                    file=sys.stderr,
                    flush=True,
                )
                warn_no_cancel()
                return 4

            time.sleep(2)

    if args.cmd == "blender":
        if not os.path.isfile(args.script):
            print(f"Error: script file not found: {args.script}", file=sys.stderr)
            return 1
        with open(args.script, "r", encoding="utf-8") as f:
            script_text = f.read()

        payload = {
            "script": script_text,
            "nodeId": args.node,
            "preferGpu": args.gpu,
        }
        if args.output:
            payload["outputName"] = args.output
        if args.preview:
            payload["previewName"] = args.preview

        res = hub_request("POST", "/api/agent-hub/blender-jobs", payload, timeout=30)
        if not res.get("ok") or not (res.get("job") or {}).get("jobId"):
            print(f"Error: {res.get('error') or 'Failed to create blender job'}", file=sys.stderr)
            return 1

        job = res["job"]
        job_id = job["jobId"]
        node_id = job.get("nodeId", args.node)
        local_monitor_url = f"{HUB_BASE.rstrip('/')}/api/agent-hub/jobs/{job_id}/monitor"
        ts_monitor_url = f"https://homelab.tail285279.ts.net/api/agent-hub/jobs/{job_id}/monitor"

        print(f"Job ID: {job_id} | Node: {node_id}", flush=True)
        print(f"Monitor (Local): {local_monitor_url}", flush=True)
        print(f"Monitor (Tailscale): {ts_monitor_url}", flush=True)

        if args.live_session:
            try:
                proc = subprocess.run(
                    [
                        "/home/dev/.local/bin/lab-browser",
                        "session",
                        "open",
                        local_monitor_url,
                        "--new-tab",
                        "--session",
                        args.live_session,
                        "--shared-auth",
                    ],
                    capture_output=True,
                    text=True,
                    timeout=30,
                )
                if proc.returncode != 0:
                    print(f"Warning: lab-browser returned {proc.returncode}: {proc.stderr.strip()}", file=sys.stderr, flush=True)
            except Exception as e:
                print(f"Warning: failed to open Browser Vision tab: {e}", file=sys.stderr, flush=True)

        if not args.wait:
            return 0

        deadline = time.time() + max(1, args.timeout)
        last_state = None
        while time.time() < deadline:
            st = hub_request("GET", f"/api/agent-hub/jobs/{job_id}/live-status", timeout=15)
            if not st.get("ok"):
                time.sleep(2)
                continue
            status = st.get("status", "unknown")
            progress = st.get("progress", 0)
            phase = st.get("phase", "")
            msg = st.get("message", "")
            state = (status, progress, phase, msg)
            if state != last_state:
                phase_str = f"[{phase}] " if phase else ""
                msg_str = f" - {msg}" if msg else ""
                print(f"[{status}] {progress}% {phase_str}{msg_str}", flush=True)
                last_state = state

            if status == "completed":
                out_name = args.output or job.get("outputName") or f"{job_id}.glb"
                prev_name = args.preview or job.get("previewName") or f"{job_id}_preview.png"
                out_path = os.path.join(args.out_dir, os.path.basename(out_name))
                prev_path = os.path.join(args.out_dir, os.path.basename(prev_name))

                if not hub_download(f"/api/agent-hub/jobs/{job_id}/output", out_path):
                    print(f"Error: failed to download output to {out_path}", file=sys.stderr)
                    return 1
                if not hub_download(f"/api/agent-hub/jobs/{job_id}/preview", prev_path):
                    prev_path = None

                summary = {
                    "ok": True,
                    "jobId": job_id,
                    "node": node_id,
                    "status": "completed",
                    "output": out_path,
                    "preview": prev_path,
                    "monitorUrl": ts_monitor_url,
                }
                print(json.dumps(summary, ensure_ascii=False, indent=2), flush=True)
                return 0

            if status == "failed":
                err = st.get("error") or st.get("message") or "Blender job failed"
                print(f"Error: {err}", file=sys.stderr)
                return 1

            time.sleep(2)

        print(f"Error: timed out after {args.timeout}s waiting for job {job_id}", file=sys.stderr)
        return 1

    if args.cmd == "rename":
        target_id = resolve_node_target(args.node)
        body = {}
        if args.clear:
            body["alias"] = ""
            if args.notes is not None:
                body["notes"] = args.notes
        else:
            if args.alias:
                body["alias"] = args.alias
            if args.notes is not None:
                body["notes"] = args.notes
        if not body:
            print("Error: specify an alias or --notes (or --clear)", file=sys.stderr)
            return 1
        res = hub_request("PATCH", f"/api/agent-hub/nodes/{urllib.parse.quote(target_id)}", body, timeout=15)
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0 if res.get("ok") else 1

    if args.cmd == "update":
        res = run_node_cmd(args.node, "self-update", {}, timeout_sec=60)
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0 if res.get("ok") else 1

    if args.cmd == "cancel":
        res = hub_request("POST", f"/api/agent-hub/jobs/{urllib.parse.quote(args.job_id)}/cancel", {}, timeout=15)
        if args.json:
            print(json.dumps(res, ensure_ascii=False))
        else:
            if res.get("ok"):
                print(f"Cancelled job {args.job_id}: {res.get('status', 'cancelling')}")
            else:
                print(f"Error cancelling {args.job_id}: {res.get('error', 'unknown error')}", file=sys.stderr)
        return 0 if res.get("ok") else 1

    if args.cmd == "jobs":
        params = {"limit": str(max(1, args.limit))}
        if args.kind:
            params["kind"] = args.kind
        qs = urllib.parse.urlencode(params)
        res = hub_request("GET", f"/api/agent-hub/jobs?{qs}", timeout=15)
        if args.json:
            print(json.dumps(res, ensure_ascii=False, indent=2))
            return 0 if res.get("ok") else 1
        if not res.get("ok"):
            print(f"Error: {res.get('error', 'failed to fetch jobs')}", file=sys.stderr)
            return 1
        jobs_list = res.get("jobs") or []
        if not jobs_list:
            print("(no jobs)")
            return 0
        header = f"{'JOB ID':<24} {'KIND':<10} {'NAME':<22} {'NODE':<18} {'STATUS':<11} {'PROG':>5}"
        print(header)
        print("-" * len(header))
        for j in jobs_list:
            jid = str(j.get("jobId") or "")[:24]
            kind = str(j.get("kind") or "")[:10]
            name = str(j.get("name") or j.get("compositionId") or "")[:22]
            node = str(j.get("nodeAlias") or j.get("alias") or j.get("nodeId") or "")[:18]
            status = str(j.get("status") or "")[:11]
            prog = f"{int(j.get('progress') or 0)}%"
            print(f"{jid:<24} {kind:<10} {name:<22} {node:<18} {status:<11} {prog:>5}")
        return 0

    if args.cmd == "run":
        return handle_run_cmd(args)

    return 0


def _extract_new_log_lines(prev_lines: list[str], cur_lines: list[str]) -> list[str]:
    if not cur_lines:
        return []
    if not prev_lines:
        return cur_lines
    max_k = min(len(prev_lines), len(cur_lines))
    for k in range(max_k, 0, -1):
        if prev_lines[-k:] == cur_lines[:k]:
            return cur_lines[k:]
    return cur_lines


def _safe_extract_tar(tar_path: str, dest_dir: str) -> list[str]:
    dest_real = os.path.realpath(dest_dir)
    extracted: list[str] = []
    with tarfile.open(tar_path, "r:gz") as tf:
        members = tf.getmembers()
        if sys.version_info >= (3, 12):
            tf.extractall(dest_dir, filter="data")
        else:
            for m in members:
                if m.islnk() or m.issym():
                    link_base = os.path.dirname(m.name) if m.issym() else ""
                    target_real = os.path.realpath(os.path.join(dest_real, link_base, m.linkname))
                    if not (target_real == dest_real or target_real.startswith(dest_real + os.sep)):
                        raise ValueError(f"Unsafe link in tar: {m.name} -> {m.linkname}")
                member_real = os.path.realpath(os.path.join(dest_real, m.name))
                if not (member_real == dest_real or member_real.startswith(dest_real + os.sep)):
                    raise ValueError(f"Unsafe path in tar: {m.name}")
            tf.extractall(dest_dir)
        for m in members:
            if m.isfile():
                extracted.append(os.path.join(dest_dir, m.name))
    return extracted


def handle_run_cmd(args) -> int:
    payload: dict = {}
    if args.spec:
        if not os.path.isfile(args.spec):
            print(f"Error: spec file not found: {args.spec}", file=sys.stderr)
            return 1
        try:
            with open(args.spec, "r", encoding="utf-8") as f:
                spec_data = json.load(f)
            if not isinstance(spec_data, dict):
                print("Error: spec JSON must be an object", file=sys.stderr)
                return 1
            payload.update(spec_data)
        except Exception as e:
            print(f"Error reading spec file: {e}", file=sys.stderr)
            return 1

    if args.name is not None:
        payload["name"] = args.name
    if args.requires is not None:
        payload["requires"] = [r.strip() for r in args.requires.split(",") if r.strip()]
    if args.os is not None:
        payload["os"] = args.os
    else:
        payload.setdefault("os", "any")

    node_ref = args.node if args.node is not None else (payload.get("nodeId") or "auto")
    if str(node_ref).strip().lower() != "auto":
        payload["nodeId"] = resolve_node_target(str(node_ref))
    else:
        payload["nodeId"] = "auto"

    if args.input is not None:
        payload["inputs"] = [os.path.abspath(p) for p in args.input]

    if args.cmd_win is not None or args.cmd_posix is not None:
        cmd_obj = dict(payload["command"]) if isinstance(payload.get("command"), dict) else {}
        if args.cmd_win is not None:
            cmd_obj["windows"] = args.cmd_win
        if args.cmd_posix is not None:
            cmd_obj["posix"] = args.cmd_posix
        payload["command"] = cmd_obj
    elif args.cmd_str is not None:
        payload["command"] = args.cmd_str

    if not payload.get("command"):
        print("Error: --cmd (or --cmd-win/--cmd-posix or spec.command) is required", file=sys.stderr)
        return 1

    if args.setup is not None:
        payload["setup"] = args.setup
    if args.cache_key is not None:
        payload["cacheKey"] = args.cache_key
    if args.collect is not None:
        payload["collect"] = args.collect
    if args.env is not None:
        env_dict = dict(payload.get("env") or {})
        for item in args.env:
            if "=" not in item:
                print(f"Error: invalid --env '{item}', expected KEY=VAL", file=sys.stderr)
                return 1
            k, v = item.split("=", 1)
            env_dict[k] = v
        payload["env"] = env_dict
    if args.timeout is not None:
        payload["timeoutSec"] = args.timeout

    res = hub_request("POST", "/api/agent-hub/jobs", payload, timeout=30)
    http_status = res.get("_http_status")
    err_code = res.get("code")
    if http_status == 404:
        msg = "hub ยังไม่รองรับ job.run (รอ restart)"
        print(f"[offload] {msg}", file=sys.stderr, flush=True)
        if args.json:
            print(json.dumps({"ok": False, "code": "NO_NODE", "error": msg}, ensure_ascii=False), flush=True)
        return 3
    if http_status == 409 or err_code == "NO_NODE":
        print("[offload] no node available", file=sys.stderr, flush=True)
        if args.json:
            print(json.dumps({"ok": False, "code": "NO_NODE", "error": res.get("error") or "no node available"}, ensure_ascii=False), flush=True)
        return 3
    if not res.get("ok") or not (res.get("job") or {}).get("jobId"):
        err_msg = res.get("error") or err_code or "hub unavailable"
        if http_status is None:
            print(f"[offload] no node available: {err_msg}", file=sys.stderr, flush=True)
            if args.json:
                print(json.dumps({"ok": False, "code": "NO_NODE", "error": err_msg}, ensure_ascii=False), flush=True)
            return 3
        print(f"Error: {err_msg}", file=sys.stderr, flush=True)
        if args.json:
            print(json.dumps({"ok": False, "code": err_code or "ERROR", "error": err_msg}, ensure_ascii=False), flush=True)
        return 1

    job = res["job"]
    job_id = job["jobId"]
    node_label = job.get("alias") or job.get("nodeAlias") or job.get("hostname") or job.get("nodeId") or payload.get("nodeId") or "unknown"

    if not args.json:
        print(f"[render-node] {node_label}", flush=True)

    if args.no_wait:
        if args.json:
            print(json.dumps({"ok": True, "jobId": job_id, "node": node_label, "status": job.get("status", "queued")}, ensure_ascii=False), flush=True)
        else:
            print(job_id, flush=True)
        return 0

    wait_timeout = int(payload.get("timeoutSec") or 1800)
    start_t = time.time()
    last_activity = None
    prev_log_lines: list[str] = []

    try:
        while True:
            if time.time() - start_t > wait_timeout:
                hub_request("POST", f"/api/agent-hub/jobs/{urllib.parse.quote(job_id)}/cancel", {}, timeout=10)
                if args.json:
                    print(json.dumps({"ok": False, "jobId": job_id, "node": node_label, "status": "timeout", "error": f"timed out after {wait_timeout}s"}, ensure_ascii=False), flush=True)
                else:
                    print(f"Error: job {job_id} timed out after {wait_timeout}s", file=sys.stderr, flush=True)
                return 4

            jres = hub_request("GET", f"/api/agent-hub/jobs/{urllib.parse.quote(job_id)}", timeout=15)
            if jres.get("ok") and jres.get("job"):
                j = jres["job"]
                status = j.get("status", "")
                progress = j.get("progress", 0) or 0
                message = j.get("message", "") or ""

                log_tail = j.get("logTail")
                if log_tail:
                    if isinstance(log_tail, list):
                        cur_lines = [str(x) for x in log_tail]
                    else:
                        cur_lines = str(log_tail).splitlines()
                    new_lines = _extract_new_log_lines(prev_log_lines, cur_lines)
                    if not args.json:
                        for ln in new_lines:
                            print(ln, flush=True)
                    prev_log_lines = cur_lines

                activity = (status, progress, message)
                if activity != last_activity:
                    last_activity = activity
                    if not args.json:
                        print(f"[{status}] {round(progress)}% {message}".rstrip(), flush=True)

                if status in ("completed", "failed", "lost", "timeout", "timed_out", "cancelled"):
                    exit_code = j.get("exitCode")
                    result_url = j.get("resultUrl")
                    out_dir = args.out_dir or os.path.join("/home/dev/.gemini/outputs/offload", job_id)
                    extracted_files: list[str] = []

                    if status in ("completed", "failed") and result_url:
                        os.makedirs(out_dir, exist_ok=True)
                        tar_path = os.path.join(out_dir, "result.tar.gz")
                        dl_path = urllib.parse.urlparse(result_url).path if result_url.startswith("http") else result_url
                        if hub_download(dl_path, tar_path, timeout=600):
                            try:
                                extracted_files = _safe_extract_tar(tar_path, out_dir)
                                if not args.json:
                                    print(f"Extracted {len(extracted_files)} file(s) to {out_dir}:", flush=True)
                                    for fp in extracted_files:
                                        print(f"  - {fp}", flush=True)
                            except Exception as e:
                                print(f"Warning: failed to extract result.tar.gz: {e}", file=sys.stderr, flush=True)
                        else:
                            print(f"Warning: failed to download result from {result_url}", file=sys.stderr, flush=True)

                    if status == "cancelled":
                        rc = 130
                    elif status in ("lost", "timeout", "timed_out"):
                        rc = 4
                    elif status == "failed" or (exit_code is not None and exit_code != 0):
                        rc = 2
                    else:
                        rc = 0

                    if args.json:
                        summary = {
                            "ok": rc == 0,
                            "jobId": job_id,
                            "node": node_label,
                            "status": status,
                            "exitCode": exit_code,
                            "outDir": out_dir if result_url else None,
                            "files": extracted_files,
                            "error": j.get("error") or (message if rc != 0 else None),
                        }
                        print(json.dumps(summary, ensure_ascii=False), flush=True)
                    elif rc != 0:
                        err = j.get("error") or message or f"job ended with status={status} exitCode={exit_code}"
                        print(f"Error: {err}", file=sys.stderr, flush=True)
                    return rc

            time.sleep(2)
    except KeyboardInterrupt:
        hub_request("POST", f"/api/agent-hub/jobs/{urllib.parse.quote(job_id)}/cancel", {}, timeout=10)
        if args.json:
            print(json.dumps({"ok": False, "jobId": job_id, "node": node_label, "status": "cancelled"}, ensure_ascii=False), flush=True)
        else:
            print(f"\nCancelled job {job_id}", file=sys.stderr, flush=True)
        return 130


if __name__ == "__main__":
    sys.exit(main())
